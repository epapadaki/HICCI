# Copy this file to .env and fill in what you need.
# .env is ignored by git, so nothing in it is ever published.

# Optional: enables the AI-assisted components (method advisor,
# literature classification, Discussion draft)
GEMINI_API_KEY=
# Optional: a specific Gemini model (blank = gemini-2.5-flash)
GEMINI_MODEL=

# Recommended by NCBI for PubMed queries
NCBI_EMAIL=
NCBI_API_KEY=
